# Normalise line endings so cross-platform (Windows/macOS/Linux) git users
# don't get CRLF/LF churn. Scripts stay LF; PowerShell stays CRLF; assets binary.
* text=auto eol=lf
*.ps1 text eol=crlf
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Media tracked in Git LFS from the first commit — docs/specs/team-deployment.md §8.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
